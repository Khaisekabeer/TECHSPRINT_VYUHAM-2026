PORT=3001
NODE_ENV=development

# Encrypts the question bank together with each quiz master's PIN. Generate once with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# and BACK IT UP: without it the encrypted questions cannot be decrypted. Every server that
# serves the same database needs the same value.
QUESTION_VAULT_SECRET=

# Split deployment only: shared between the Vercel API and the event-day game server so the API
# can push the quiz master's loaded questions to the laptop. Same value on both sides.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GAME_LINK_SECRET=

# Password for the first admin account "admin", created on first start when no staff exist.
# Sign in, create real staff accounts in Admin -> Staff, then change or disable "admin".
ADMIN_PASSWORD=change-me

# Serve over HTTPS (self-signed cert generated in backend/certs/) so phone cameras can scan passes.
HTTPS=false

# Supabase -> Project Settings -> API Keys. The secret key bypasses RLS: backend only, never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
