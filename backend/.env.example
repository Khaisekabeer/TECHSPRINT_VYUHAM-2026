PORT=3001
NODE_ENV=development

# Password for the first coordinator account "admin", created on first start when no staff exist.
# Sign in, create real staff accounts in Admin -> Staff, then change or disable "admin".
ADMIN_PASSWORD=change-me

# Serve over HTTPS (self-signed cert generated in backend/certs/) so phone cameras can scan passes.
HTTPS=false

# Supabase -> Project Settings -> API Keys. The secret key bypasses RLS: backend only, never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
