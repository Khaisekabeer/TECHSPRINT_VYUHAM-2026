# Database (If using Supabase, use the Transaction connection pooler string and append ?ssl=require)
# Example: postgresql+asyncpg://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/techquiz

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=development_secret_key_change_me_in_prod

# Application
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Frontend Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
