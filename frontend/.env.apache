# Used by `npm run build:apache` (static build for the Apache subfolder).
# Folder on the Apache site, with leading and trailing slash.
VITE_BASE_PATH=/techquiz/
# The Vercel deployment that serves /api/* (admin, check-in, config). Public address, not a secret.
VITE_API_BASE=https://techquiz-vyuham.vercel.app

